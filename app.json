{
  "expo": {
    "name": "cafiapp",
    "slug": "cafiapp",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/logo-navidad.png",
    "scheme": "cafiapp",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/logo-navidad.png"
    },
    "android": {
    "adaptiveIcon": {
  "backgroundColor": "#E6F4FE",
  "foregroundImage": "./assets/logo-navidad.png"
},
      "predictiveBackGestureEnabled": false,
      "package": "com.lilgarcia.cafiapp"
    },
    "web": {
      "output": "server",
      "favicon": "./assets/logo-navidad.png"
    },
    "plugins": [
      "expo-router",
    [
  "expo-splash-screen",
  {
    "backgroundColor": "#208AEF",
    "image": "./assets/logo-navidad.png",
    "imageWidth": 76
  }
]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "7ce86538-3c21-4524-8a04-f0bd7a1c5ed7"
      }
    }
  }
}
